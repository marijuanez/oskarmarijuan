{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".git/**",
      "**/.*",
      "**/node_modules/**",
      "**/*.php",
      "public/**",
      "README.md",
      "README_DEPLOY.md",
      ".gitignore",
      "package*.json",
      "php/**",
      "demo-images/**",
      "firebase-debug.log",
      "portfolioX.html",
      "portfolio_legacy.html",
      "index-blog.html",
      "index-image.html",
      "index-slider.html",
      "index-video.html",
      "single.html",
      "single-portfolio.html",
      "about.html",
      "blog.html",
      "contact-map.html"
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|mp4|woff|woff2|ttf|eot|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.pdf",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  }
}
